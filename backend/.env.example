# Copy this file to .env and adjust as needed. .env itself is gitignored -
# each environment (local dev, production) sets its own values.

# Comma-separated list of origins allowed to call this API (CORS).
# In production, set this to the deployed frontend's real URL(s).
ALLOWED_ORIGINS=http://localhost:5173

# Port to listen on. Most hosting platforms set this automatically at
# runtime - only needed locally if 8000 is taken.
PORT=8000

# Log verbosity: DEBUG, INFO, WARNING, ERROR (see backend/logger.py)
LOG_LEVEL=INFO

# Base URL the prebuilt per-match data files are downloaded from. Defaults
# to this repo's "match-data" GitHub release - only set this to point at a
# fork's release or a local file server.
# MATCH_DATA_BASE_URL=https://github.com/MihirT906/PlayTactix/releases/download/match-data
