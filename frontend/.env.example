# Copy this file to .env (or .env.local) and adjust as needed.
# .env itself is gitignored - each environment sets its own value.

# Backend API base URL. Defaults to the local dev backend if unset.
VITE_API_URL=http://localhost:8000

# PostHog project key for usage analytics (unique visitors, actives, retention, feature use).
# Leave unset to turn analytics off. Never sent from `npm run dev`. Set it in Vercel's env vars.
# VITE_POSTHOG_KEY=phc_...
# EU-hosted PostHog projects use https://eu.i.posthog.com
# VITE_POSTHOG_HOST=https://us.i.posthog.com
